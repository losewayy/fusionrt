#version 450

layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer LogitsBuf { float logits[]; };
layout(std430, binding = 1) buffer IdxBuf { int topk_idx[]; };
layout(std430, binding = 2) buffer WeightBuf { float topk_weight[]; };
layout(push_constant) uniform Params { int num_experts, top_k, norm_topk; float scale; };

void main() {
    float max_l = -3.402823e38;
    for (int e = 0; e < num_experts; ++e) max_l = max(max_l, logits[e]);
    float sum_e = 0.0;
    for (int e = 0; e < num_experts; ++e) sum_e += exp(logits[e] - max_l);

    float wsum = 0.0;
    for (int k = 0; k < top_k; ++k) {
        int best_e = -1;
        for (int e = 0; e < num_experts; ++e) {
            bool used = false;
            for (int p = 0; p < k; ++p) used = used || topk_idx[p] == e;
            if (!used && (best_e < 0 || logits[e] > logits[best_e])) best_e = e;
        }
        float p = exp(logits[best_e] - max_l) / sum_e;
        topk_idx[k] = best_e;
        topk_weight[k] = p;
        wsum += p;
    }
    float scale_factor = scale / (norm_topk != 0 ? max(wsum, 0.00006103515625) : 1.0);
    for (int k = 0; k < top_k; ++k) topk_weight[k] *= scale_factor;
}

#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Fused Pre-Norm (RMSNorm) + vec4 GEMV (M=1..8)
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { vec4 x[]; };
layout(std430, binding = 1) readonly buffer NBuf { vec4 norm_w[]; };
layout(std430, binding = 2) readonly buffer WBuf { vec4 w[]; };
layout(std430, binding = 3) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Params {
    int M;
    int N;
    int K;
    float eps;
};

shared float smem[16];
shared float inv_rms_sh[8];

void main() {
    int n = int(gl_WorkGroupID.x);
    if (n >= N) return;
    int tid = int(gl_LocalInvocationID.x);
    int k4 = K >> 2;

    for (int m = 0; m < M; ++m) {
        float sq = 0.0;
        for (int i = tid; i < k4; i += 128) {
            vec4 xv = x[m * k4 + i];
            sq += dot(xv, xv);
        }
        float sg = subgroupAdd(sq);
        if (subgroupElect()) smem[gl_SubgroupID] = sg;
        barrier();
        if (gl_SubgroupID == 0) {
            float v = (gl_SubgroupInvocationID < gl_NumSubgroups) ? smem[gl_SubgroupInvocationID] : 0.0;
            float tot = subgroupAdd(v);
            if (subgroupElect()) inv_rms_sh[m] = inversesqrt(tot / float(K) + eps);
        }
        barrier();
    }

    float acc[8];
    for (int m = 0; m < 8; ++m) acc[m] = 0.0;

    int w_row = n * k4;
    for (int i = tid; i < k4; i += 128) {
        vec4 nw = norm_w[i];
        vec4 wv = w[w_row + i] * nw;
        for (int m = 0; m < M; ++m) {
            vec4 xv = x[m * k4 + i];
            acc[m] += dot(xv, wv) * inv_rms_sh[m];
        }
    }

    for (int m = 0; m < M; ++m) {
        float sg = subgroupAdd(acc[m]);
        if (subgroupElect()) smem[gl_SubgroupID] = sg;
        barrier();
        if (gl_SubgroupID == 0) {
            float v = (gl_SubgroupInvocationID < gl_NumSubgroups) ? smem[gl_SubgroupInvocationID] : 0.0;
            float tot = subgroupAdd(v);
            if (subgroupElect()) y[m * N + n] = tot;
        }
        barrier();
    }
}

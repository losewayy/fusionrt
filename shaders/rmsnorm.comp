#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer WBuf { float w[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    float eps;
};

shared float smem[32];

void main() {
    uint row = gl_WorkGroupID.x;
    if (int(row) >= rows) return;
    uint tid = gl_LocalInvocationID.x;

    float sq = 0.0;
    for (int c = int(tid); c < cols; c += 256) {
        float v = x[int(row) * cols + c];
        sq += v * v;
    }
    float sg_sum = subgroupAdd(sq);
    if (subgroupElect()) {
        smem[gl_SubgroupID] = sg_sum;
    }
    barrier();

    if (gl_SubgroupID == 0) {
        float val = (gl_SubgroupInvocationID < gl_NumSubgroups) ? smem[gl_SubgroupInvocationID] : 0.0;
        float tot = subgroupAdd(val);
        if (subgroupElect()) {
            smem[0] = inversesqrt(tot / float(cols) + eps);
        }
    }
    barrier();

    float inv_rms = smem[0];
    for (int c = int(tid); c < cols; c += 256) {
        y[int(row) * cols + c] = x[int(row) * cols + c] * inv_rms * w[c];
    }
}

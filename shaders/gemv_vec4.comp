#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Vectorized vec4 subgroup-reduced GEMV/GEMM for M=1..8
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { vec4 x[]; };
layout(std430, binding = 1) readonly buffer WBuf { vec4 w[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Params {
    int M;
    int N;
    int K;  // must be divisible by 4
};

shared float smem[16];

void main() {
    int n = int(gl_WorkGroupID.x);
    if (n >= N) return;
    int tid = int(gl_LocalInvocationID.x);
    int k4 = K >> 2;

    float acc[8];
    for (int m = 0; m < 8; ++m) acc[m] = 0.0;

    int w_row = n * k4;
    for (int i = tid; i < k4; i += 128) {
        vec4 wv = w[w_row + i];
        for (int m = 0; m < M; ++m) {
            vec4 xv = x[m * k4 + i];
            acc[m] += dot(xv, wv);
        }
    }

    for (int m = 0; m < M; ++m) {
        float sg = subgroupAdd(acc[m]);
        if (subgroupElect()) smem[gl_SubgroupID] = sg;
        barrier();
        if (gl_SubgroupID == 0) {
            float v = (gl_SubgroupInvocationID < gl_NumSubgroups) ? smem[gl_SubgroupInvocationID] : 0.0;
            float tot = subgroupAdd(v);
            if (subgroupElect()) y[m * N + n] = tot;
        }
        barrier();
    }
}

#version 450

// Tiled FP32 GEMM fallback (Y[M, N] = X[M, K] * W[N, K]^T)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer WBuf { float w[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Params {
    int M;
    int N;
    int K;
};

shared float sx[16][16];
shared float sw[16][16];

void main() {
    int row = int(gl_GlobalInvocationID.y);
    int col = int(gl_GlobalInvocationID.x);
    int lx = int(gl_LocalInvocationID.x);
    int ly = int(gl_LocalInvocationID.y);

    float acc = 0.0;
    for (int t = 0; t < K; t += 16) {
        int kx = t + lx;
        int kw = t + ly;
        sx[ly][lx] = (row < M && kx < K) ? x[row * K + kx] : 0.0;
        sw[ly][lx] = (col < N && kw < K) ? w[col * K + kw] : 0.0;
        barrier();
        for (int k = 0; k < 16; ++k) {
            acc += sx[ly][k] * sw[k][lx];
        }
        barrier();
    }
    if (row < M && col < N) {
        y[row * N + col] = acc;
    }
}
